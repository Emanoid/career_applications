rules_version = '2';

// Deny-all client access.
//
// The app reaches Firestore exclusively through the Firebase Admin SDK (a
// service account), which bypasses these rules entirely — so the app is
// unaffected. These rules exist to ensure that no client SDK or unauthenticated
// caller can read or write the database directly. All authorization is
// enforced in application code (the service layer), not here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
